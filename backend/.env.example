# Copy to ../.env (repo root of api-sandbox-links/) and fill in. The backend
# loads ./.env from its working directory, so start it from api-sandbox-links/.
# (repo-root .env.example is the canonical template; this file mirrors it)
DATABASE_URL=postgres://user:pass@localhost:5434/sandbox_platform # CHANGE FOR YOUR ENV
REDIS_URL=redis://localhost:6380 # CHANGE FOR YOUR ENV

# Leave both empty for dev auth mode (auto-seeded devuser, no OAuth round-trip).
# Set real values to enable GitHub single sign-on + push-from-sandbox.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

GEMINI_API_KEY=

# 32 random bytes, base64:  openssl rand -base64 32
# WARNING: rotating invalidates stored env vars and git tokens.
SECRETS_ENCRYPTION_KEY=

# GitHub webhook secret for POST /api/webhooks/github (hex-encoded 64-char string)
GITHUB_WEBHOOK_SECRET=

# Optional overrides
DOCKER_HOST=
# Builder engine: "railpack" (default) or "nixpacks" (deprecated fallback)
BUILDER=railpack
RAILPACK_BIN=railpack
BUILDKIT_HOST=tcp://127.0.0.1:1234
# NIXPACKS_BIN=nixpacks
SANDBOX_WORK_DIR=
BACKEND_PORT=8080
GATEWAY_PORT=8090
FRONTEND_URL=http://localhost:3000
SANDBOX_BASE_DOMAIN=sandbox.localhost
# Abuse controls / build capacity (defaults shown).
# MAX_LIFETIME_SECONDS=604800
# MAX_ACTIVE_SANDBOXES_PER_USER=3
# MAX_RUNNING_SANDBOXES=6
# BUILD_CONCURRENCY=2
# BUILD_RATE_LIMIT=12
# BUILD_RATE_WINDOW_SECONDS=3600

# Container hardening & isolation (defaults shown)
# SANDBOX_INIT=true
# SANDBOX_HARDENED=false
# SANDBOX_RUNTIME=runsc

# Gateway protection (defaults shown)
# GATEWAY_RATE_LIMIT_RPS=100
# GATEWAY_RATE_LIMIT_BURST=200
# GATEWAY_MAX_BODY_BYTES=33554432

# Production TLS / Ingress (for docker-compose.prod.yml)
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com
# ACME_DNS_PROVIDER=cloudflare
# CF_DNS_API_TOKEN=
